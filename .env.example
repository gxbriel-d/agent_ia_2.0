# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Neon PostgreSQL Database Configuration (Fonte da Verdade + PGVector)
NEON_DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis Configuration (Estado Temporario de Sessao / Debounce Buffer)
REDIS_URL=redis://localhost:6379/0
DEBOUNCE_SECONDS=15

# Google Calendar Integration Configuration
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials.json

# LangSmith Observability & Tracing Configuration
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=agente-orcamentos-vidracaria

# App Settings
APP_PORT=8000
TIMEZONE=America/Sao_Paulo
